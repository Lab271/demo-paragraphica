# 1Password secret references for Terra Virtualis (no secrets in this file).
# Same vault/items/fields the Ansible role uses (ansible/role/tasks/main.yml).
#
#   op run --env-file=op.env -- uv run terra generate ...     # one command
#   eval "$(tools/op-env.sh)"                                  # export into the current shell
#
# Item "Gemini" field "paragraphica" is new: create it in the Labs vault with the
# key from https://aistudio.google.com/apikey (see README).
GEMINI_API_KEY=op://Labs/Gemini/paragraphica
OPENAI_API_KEY=op://Labs/openai.com/paragraphica
PARA_MAPBOX_API=op://Labs/Mapbox/paragraphica
PARA_OPENWEATHERMAP_API=op://Labs/Openweathermap/paragraphica
