# 1Password secret references for Terra Virtualis (no secrets in this file).
#
#   op run --env-file=op.env -- uv run terra generate ...     # one command
#   eval "$(tools/op-env.sh)"                                  # export into the current shell
#
# Model keys live on the project item "paragraphica" in the Labs vault, one field
# per vendor (README, "API keys"). Mapbox and OpenWeatherMap keep their own items.
GEMINI_API_KEY=op://Labs/paragraphica/Gemini
OPENROUTER_API_KEY=op://Labs/paragraphica/OpenRouter
PARA_MAPBOX_API=op://Labs/Mapbox/paragraphica
PARA_OPENWEATHERMAP_API=op://Labs/Openweathermap/paragraphica
